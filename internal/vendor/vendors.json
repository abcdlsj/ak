  {
    "id": "opendesign",
    "name": "Open Design",
    "category": "aggregator",
    "website_url": "https://open-design.ai",
    "login": [
      {
        "method": "device",
        "device": {
          "start": {
            "url": "https://amr-api.open-design.ai/api/v1/cli/device-authorizations",
            "body": {
              "cliVersion": "0.1.4",
              "host": "{{host}}",
              "profile": "prod"
            }
          },
          "code": "userCode",
          "verify_url": "activationUrl",
          "interval": "pollIntervalSeconds",
          "expires": "expiresAt",
          "poll": {
            "url": "https://amr-api.open-design.ai/api/v1/cli/device-authorizations/{{deviceId}}/token",
            "body": {
              "deviceSecret": "{{deviceSecret}}"
            }
          },
          "key": "runtimeKey",
          "secrets": {
            "control": "controlKey"
          },
          "user": "user.email"
        }
      }
    ],
    "engines": {
      "claude": {
        "base_url": "https://amr-link.open-design.ai",
        "model": "deepseek-v4-pro"
      },
      "codex": {
        "base_url": "https://amr-link.open-design.ai/v1",
        "model": "gpt-6-luna",
        "wire_api": "responses"
      },
      "pi": {
        "base_url": "https://amr-link.open-design.ai/v1",
        "model": "deepseek-v4-pro",
        "pi_api": "openai-completions"
      }
    }
